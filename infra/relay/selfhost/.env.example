# Copy to infra/relay/selfhost/.env. Keep it private: it holds secrets.

# DNS: point RELAY_DOMAIN and *.RELAY_TUNNEL_DOMAIN (a wildcard A/AAAA record)
# at this server. APP_DOMAIN is optional; see the guide.
RELAY_DOMAIN=relay.example.com
RELAY_TUNNEL_DOMAIN=tunnels.example.com
# APP_DOMAIN=app.example.com
# WEB_APP_DIR=../../../apps/web/dist
ACME_EMAIL=you@example.com

POSTGRES_PASSWORD=change-me

# Linked environments per account (the hosted service allows 3).
# RELAY_TUNNEL_LIMIT=100

# Clerk (your own instance): Dashboard > API keys. CLERK_JWT_AUDIENCE matches
# the `aud` claim of the `t3-relay` JWT template.
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_JWT_AUDIENCE=t3-code-relay

# Apple Push Notifications, from your Apple Developer account. APNS_BUNDLE_ID
# is the bundle ID of your own iOS build (T3CODE_IOS_BUNDLE_ID).
APNS_ENVIRONMENT=production
APNS_TEAM_ID=ABCDE12345
APNS_KEY_ID=ABC123DEFG
APNS_BUNDLE_ID=com.example.t3code
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_ENABLED=false

# Optional: Android push. The Firebase service account JSON.
# FCM_SERVICE_ACCOUNT={...}

# Optional: inactive tunnel cleanup (off, dry-run, enabled).
# RELAY_TUNNEL_CLEANUP_MODE=off
